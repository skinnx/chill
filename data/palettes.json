	"weather": {
		"doc": "Wind, cloud cover, rain particle count and crossfade time are owned by data/world.json (weather[]). This block is only the art transform applied by the PaletteDriver, scaled by g_rain (0..1, follows the weather crossfade).",
		"rain_transform": {
			"chroma_mul": 0.55,
			"sky_L_add": -0.04,
			"key_chroma_mul": 0.4,
			"key_L_add": -0.06,
			"rim_mul": 0.5,
			"backlight_mul": 0.2,
			"shafts_mul": 0.0,
			"ground_light_mul": 0.3,
			"halo_alpha_mul": 0.4,
			"cloud_shadow_mul": 0.0,
			"ground_wet_sheen": 0.15,
			"mist_add": 0.1,
			"then": "g_ambient *= world.json weather.ambient_mult",
			"applies_to": [
				"sky_top",
				"sky_mid",
				"sky_horizon",
				"far",
				"mid",
				"near",
				"fg",
