{
	"schema": 1,
	"name": "Felted Diorama palettes",
	"doc": "docs/ART_BIBLE.md §3. TOD base slots and UI tokens are verbatim from docs/research/05 §0.4; every other colour is derived as stated in derived_formulas (OKLab mixes) or authored in ART_BIBLE §3.4-3.5.",
	"format": {
		"color": "sRGB hex #RRGGBB (Color.html())",
		"alpha": "separate float 0..1",
		"interpolation": "Gradient.GRADIENT_COLOR_SPACE_OKLAB, offset = g_day (keys in tod.gradient_keys); scalars lerp linearly on the same keys",
		"shader_space": "Compatibility 2D blends in non-linear sRGB; multiply tokens as stored"
	},
	"tod": {
		"order": [
			"dawn",
			"day",
			"golden",
			"dusk",
			"night"
		],
		"base_slots": [
			"sky_top",
			"sky_mid",
			"sky_horizon",
			"glow",
			"far",
			"mid",
			"near",
			"fg",
			"ambient",
			"key",
			"shadow",
			"accent"
		],
		"derived_formulas": {
			"ground_back": "oklab_mix(oklab_mix(near, mid, 0.20), sky_horizon, 0.06)",
			"ground_front": "near",
			"ground_back_lit": "oklab_mix(ground_back, key, scalars.ground_light)",
			"ground_front_lit": "oklab_mix(ground_front, key, scalars.ground_light)",
			"ground_path": "oklab_mix(oklab_mix(ground_back_lit, sky_horizon, 0.18), materials.soil.detail, 0.22)",
			"grass_tip": "oklab_mix(oklab_mix(near, mid, 0.15), key, 0.28)",
			"grass_root": "oklab_mix(near, shadow, 0.25)",
			"water_deep": "oklab_mix(oklab_mix(near, shadow, 0.40), sky_top, 0.30)",
			"water_shallow": "oklab_mix(sky_mid, sky_horizon, 0.55)",
			"water_bank": "oklab_mix(near, shadow, 0.30)",
			"cloud_lit": "oklab_mix(sky_horizon, glow, 0.60)",
			"cloud_shade": "oklab_mix(sky_mid, shadow, 0.18)",
			"far_haze": "oklab_mix(far, sky_horizon, 0.30)  (L2 haze in shader goes 0.55-0.70 toward sky_horizon with height; this is the crest value)",
			"mid_haze": "oklab_mix(mid, sky_horizon, 0.15)"
		},
		"gradient_keys": [
