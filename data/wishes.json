		"trait_bonus": 1.5,
		"prefer_mult": 3.0,
		"repeat_mult": 0.25,
		"unseen_mult": 2.0,
		"greeter": "A greeter never spawns a wish. The greeter is preferably a met friend holding a wish (oldest opened_t first) and it brings that held wish back for its stay (GDD 14.2)."
	},
	"reward": {
		"affection_per_wish": 1,
		"wish_affection_rest_s": 72000,
		"rest_clock": "wish_aff_t (separate from visit_aff_t)",
		"gift": {
			"kind": "petal",
			"count": 1,
			"flower_rule": "tea.json species_prefs[species].gift_petal if that flower has a bloomed stem, else the flower with the most bloomed stems (ties: garden order)",
			"respects_f2_petal_cap": true,
			"fallback_if_no_f2": "none"
		},
		"stamp_on_first_grant": true,
		"stacking": "A cup that grants a tea wish also gives its tea.json offering credit (own 20 h rest, tea_aff_t). Together at most +3 affection per friend per 20 h from the active layer (GDD 14.6)."
	},
