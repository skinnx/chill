{
	"schema": 1,
	"doc": "Active play F1 Wishes (docs/gdd/ACTIVE_WISHES.md). Durations in seconds of foreground world time unless the key says otherwise. Randomness only via the retention hash (GDD 13.1) with the keys in hash_keys; never the world RNG. Targets use the grammar in ACTIVE_WISHES.md section 5. Wishes never expire and nothing here ever decreases.",
	"tuning": {
		"max_visible": 2,
		"max_pending": 4,
		"max_per_friend": 1,
		"max_spawned_per_visit": 2,
		"spawn_check_s": 60,
		"spawn_chance": 0.4,
		"global_gap_s": 90,
		"friend_gap_s": 600,
		"min_present_s": 45,
		"no_spawn_while": ["napping", "petting", "leaving", "scene_cast", "entering"],
		"first_wish": {"wish": "cuddle", "after_onboarding_s": 60, "species": "first_present_onboarding_friend"},
