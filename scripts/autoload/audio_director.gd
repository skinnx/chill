extends Node
## AudioDirector (autoload): executes docs/AUDIO_BIBLE.md §8 against res://audio/manifest.json.
## The Sound Designer owns every level, pitch and timing (manifest, generated by
## tools/audio/synth.py); tools/audio/mixsim.py is the executable reference of §8.4-§8.7, so if this
## file and the simulator disagree, one of them has a bug.
##
##  L0 beds (4, always playing, equal-power gain fades, asleep after 2 s of silence) + birds
##  L1 pads: one AudioStreamInteractive (10 clips = harmony.pad_clip_order), NEXT_BAR switches with
##     a 6-beat crossfade; the sounding chord is polled every frame (Web: two plain players, §9)
##  L2 Eno voices (AudioStreamPolyphonic), L3 critters (coo/snore) and wind-chime gusts
##  Cues S01-S21 with the §8.6 pitch rules, haptics in the same frame, cue_played for captions
##  Rests, fatigue guard, S09/S10 swell + hush, Music LPF duck, X1 sound settings (§8.9)
## Without a manifest it still builds the bus graph and fires haptics and cue_played.

# Data boundary: values read from JSON / Dictionaries are Variants and each one is converted
# explicitly (int(), float(), String() ...) where it is read; the analyzer still flags every
# such conversion, so only that warning is silenced in this file (docs/ARCHITECTURE.md §10).
@warning_ignore_start("unsafe_call_argument")

signal chord_changed(chord_name: StringName)
## Every cue, for captions (X1): the UI shows caption_key near world_position if Captions is on.
signal cue_played(cue_id: StringName, caption_key: StringName, world_position: Vector2)

const MANIFEST_SCHEMA := 1
## §8.9: bus_db = bus volume_db + 30 * log10(slider / 80); slider 0 mutes the bus.
const VOLUME_CURVE_DB := 30.0
const VOLUME_REFERENCE := 80.0
const MIN_DB := -80.0
## §8.3: a bed at silence for this long is stopped (a muted Vorbis stream still decodes).
const BED_SLEEP_AFTER_S := 2.0
## §6: at most this many SFX-bus sounds at once (oldest stopped first).
const SFX_BUS_MAX_VOICES := 4
## §6: variants get a random level offset in this range (timbre/level only, never pitch).
const VARIANT_LEVEL_DB: Array[float] = [-1.5, 0.0]
## §9: Web bed A/B crossfade before the end of the file (sample loops restart on `ended`).
const WEB_BED_XFADE_S := 3.0
const POLYPHONY := 32
const PRELOAD_COLLECT_PER_FRAME := 16
const BUS_MUSIC := &"Music"
const BUS_AMBIENCE := &"Ambience"
const BUS_SFX := &"SFX"
const BUS_UI := &"UI"
const ROLE_MONO := "mono_toggle"
const ROLE_DUCK := "tone_duck"
const MODE_ON := &"on"
const MODE_AMBIENCE := &"ambience"
const MODE_OFF := &"off"
const FALLBACK_BUSES := [
	{"name": "Master", "volume_db": 0.0, "send": "", "effects": [
		{"class": "AudioEffectStereoEnhance", "enabled": false, "props": {"pan_pullout": 0.0}, "role": "mono_toggle"},
		{"class": "AudioEffectHardLimiter", "enabled": true, "props": {"ceiling_db": -1.5}, "role": "safety_limiter"}]},
	{"name": "Music", "volume_db": -3.0, "send": "Master", "effects": [
		{"class": "AudioEffectLowPassFilter", "enabled": true, "props": {"cutoff_hz": 20000.0, "resonance": 0.5},
			"role": "tone_duck"}]},
	{"name": "Ambience", "volume_db": -6.0, "send": "Master", "effects": []},
	{"name": "SFX", "volume_db": 0.0, "send": "Master", "effects": [
		{"class": "AudioEffectReverb", "enabled": true, "role": "room", "props": {"room_size": 0.5, "damping": 0.25,
			"spread": 0.8, "hipass": 0.15, "predelay_msec": 20.0, "predelay_feedback": 0.0, "dry": 1.0, "wet": 0.15}}]},
	{"name": "UI", "volume_db": -3.0, "send": "Master", "effects": []},
]


## Equal-power gain fade in linear amplitude (§8.3): g(u) = sqrt(a^2 cos^2(u pi/2) + b^2 sin^2(u pi/2)).
class Fader:
	var from: float = 0.0
	var to: float = 0.0
	var t0: float = 0.0
	var dur: float = 0.0

	func _init(value: float = 0.0) -> void:
		from = value
		to = value

	func value_at(now: float) -> float:
		if now < t0:
			return from
		if dur <= 0.0 or now >= t0 + dur:
			return to
		var u := clampf((now - t0) / dur, 0.0, 1.0) * PI * 0.5
		return sqrt(from * from * cos(u) * cos(u) + to * to * sin(u) * sin(u))

	func go(now: float, target: float, seconds: float) -> void:
		from = value_at(now)
		to = target
		t0 = now
		dur = seconds

	func moving(now: float) -> bool:
		return dur > 0.0 and now < t0 + dur


