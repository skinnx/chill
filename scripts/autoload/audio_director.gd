func _ready() -> void:
	process_mode = Node.PROCESS_MODE_ALWAYS
	_web = OS.has_feature("web")
	manifest = ContentRegistry.audio_manifest()
	if not manifest.is_empty() and int(manifest.get("schema", 0)) != MANIFEST_SCHEMA:
		push_warning("AudioDirector: unsupported manifest schema %s" % str(manifest.get("schema")))
		manifest = {}
	has_audio = not _list(manifest, "assets").is_empty()
	var buses: Array = manifest.get("buses", FALLBACK_BUSES)
	build_buses(buses)
	_flow = _sect("music_flow")
	_tempo = _sect("tempo")
	_beat_s = 60.0 / float(_tempo.get("bpm", 70))
	_bar_s = _beat_s * float(_tempo.get("bar_beats", 4))
	# JSON numbers parse as floats and Array.has() is type-strict ([5.0].has(5) is false), so the
	# pitch-class sets are converted to ints once, here at the data boundary.
	_chords = _list(_sect("harmony"), "chords").duplicate(true)
	for c: Dictionary in _chords:
		c["pcs"] = Harmony.pc_list(_list(c, "pcs"))
	_clip_order = _list(_sect("harmony"), "pad_clip_order")
	for a: Dictionary in _list(manifest, "assets"):
		var id := String(a["id"])
		_assets[id] = a
		_paths[id] = String(a.get("web_path", a["path"])) if _web else String(a["path"])
		# Birds come from the asset list, as in mixsim.py (banks.bird.variants keys collide).
		if String(a.get("bank", "")) == "bird":
			_bird_ids.append(id)
	_bird_ids.sort()
	for a: String in OS.get_cmdline_user_args():
		if a.begins_with("--audio-seed="):
			_seed_override = a.get_slice("=", 1).to_int()
	set_install_seed(0)
	Settings.changed.connect(_on_setting_changed)
	TimeOfDay.phase_changed.connect(func(p: StringName) -> void: set_phase(p))
	TimeOfDay.weather_changed.connect(func(w: StringName) -> void: set_weather(w))
	_mode = StringName(Settings.get_string(Settings.MUSIC))
	_music_mode_fader = Fader.new(1.0 if _music_wanted() else 0.0)
	_ambience_mode_fader = Fader.new(0.0 if _mode == MODE_OFF else 1.0)
	_apply_bus_volumes()
	set_mono(Settings.get_bool(Settings.MONO))


func _notification(what: int) -> void:
	if what == NOTIFICATION_APPLICATION_FOCUS_OUT:
		_focus_out = true
		_apply_lpf(float(_sect("duck").get("lpf_tween_s", 0.0)))
	elif what == NOTIFICATION_APPLICATION_FOCUS_IN:
		_focus_out = false
		_apply_lpf(float(_sect("duck").get("lpf_tween_s", 0.0)))


func _exit_tree() -> void:
	for path: String in _requested.keys():
		ResourceLoader.load_threaded_get(path)  # never leave a load token pending at exit
	_requested.clear()
	stop_all()


func _process(delta: float) -> void:
	_collect_preloads()
	var now := Clock.ticks_s()
	_update_faders(now)
	if not _started:
		return
	_foreground_s += delta
	_poll_chord()
	_conduct(now)
	_service_notes(now)
	_ambient_events(now)
	_sleep_beds(now)


# ================================================================= public API (§8.1)

## Seeds the director with manifest.seed XOR the install seed (§8.2); --audio-seed=N overrides.
func set_install_seed(install_seed: int) -> void:
	_rng.seed = _seed_override if _seed_override >= 0 else (int(manifest.get("seed", 0)) ^ install_seed)


## Starts the world layers: beds fade in over boot_bed_fade_in_s, the pad joins at
## boot_pad_delay_s with boot_pad_fade_in_s (§8.2, GDD §3.4). Called when the hollow is visible.
## Headless runs (Dummy driver, CI) skip the endless layers so nothing stays registered with the
## AudioServer at exit; Xvfb and Movie Maker captures play everything.
func start_world_audio() -> void:
	if _started:
		return
	_started = true
	var now := Clock.ticks_s()
	if not _pinned:
		_profile = _profile_for(TimeOfDay.phase if TimeOfDay.phase != &"" else &"day")
		_profile_active = _profile
		_weather = TimeOfDay.weather
	var critters := _sect("critters")
	_schedule_rest(now + float(_flow.get("boot_pad_delay_s", 0.0)))
	_next_coo_s = now + _rand_range(_list(critters, "coo_interval_s"))
	_next_snore_s = now + _rand_range(_list(critters, "snore_interval_s"))
	_schedule_gust(now)
	_schedule_bird(now)
	if not has_audio or not _can_play():
		return
	_ensure_players()
	if _mode != MODE_OFF:
		_start_beds(now, float(_flow.get("boot_bed_fade_in_s", 0.0)))
	if _music_wanted():
		_start_music(now, float(_flow.get("boot_pad_delay_s", 0.0)))
	_apply_lpf(0.0)


## Plays a cue (S01..S21). ctx: "world" (S01 bus), "voice_step" (S03/S12/S13), "nap" (S12),
## "on" (S15), "shells" (S21), "gust" (S21 gust), "position" (caption anchor), "haptic" (default true).
func play_cue(cue_id: StringName, ctx: Dictionary = {}) -> void:
	var cue := _sub(_sect("cues"), String(cue_id))
	if cue.is_empty():
		return
	var now := Clock.ticks_s()
	if bool(ctx.get("haptic", true)):
		var once := bool(cue.get("haptic_once_per_burst", false))
		if not once or now - _last_collect_haptic_s > _ladder_reset_s(cue):
			Haptics.play_for_cue(cue.get("haptic"), cue_id)
		if once:
			_last_collect_haptic_s = now
	if String(cue_id) in ["S09", "S10"]:
		_hush_until_s = now + float(_flow.get("voice_hush_s", 0.0))
		_swell(now)
	if has_audio and _can_play():
		_ensure_players()
		var bus := StringName(cue.get("bus", "SFX"))
		if bool(ctx.get("world", false)) and cue.has("world_bus"):
			bus = StringName(cue["world_bus"])
		if bool(ctx.get("gust", false)) and cue.has("gust_bus"):
			bus = StringName(cue["gust_bus"])
		for layer: Dictionary in _list(cue, "layers"):
			_play_layer(String(cue_id), cue, layer, bus, ctx)
	var caption: Variant = cue.get("caption")
	var caption_key: StringName = StringName(String(caption)) if caption != null else &""
	var position: Vector2 = ctx.get("position", Vector2.ZERO)
	cue_played.emit(cue_id, caption_key, position)


## S03 purr on its own player (its fades must work on every platform, §9); TICK every
## haptic.full_repeat_ms in Full (§7).
func start_purr(voice_step: int) -> void:
	var cue := _sub(_sect("cues"), "S03")
	if cue.is_empty():
		return
	var hap := _sub(cue, "haptic")
	if hap.get("full_repeat_ms") != null and hap.get("full") != null:
		Haptics.start_repeat(StringName(String(hap["full"])), int(hap["full_repeat_ms"]))
	var caption: Variant = cue.get("caption")
	cue_played.emit(&"S03", StringName(String(caption)) if caption != null else &"", Vector2.ZERO)
	if not has_audio or not _can_play():
		return
	_ensure_players()
	var layers := _list(cue, "layers")
	if layers.is_empty():
		return
	var layer: Dictionary = layers[0]
	var bank := _bank(String(layer.get("bank", "")))
	var stream := _note_stream(bank, _pick_note("S03", layer, bank, {"voice_step": voice_step}))
	if stream == null:
		return
	_purr.stream = stream
	_purr.bus = StringName(cue.get("bus", "SFX"))
	_purr_fader = Fader.new(0.0)
	_purr_fader.go(Clock.ticks_s(), db_to_linear(float(layer.get("gain_db", 0.0))), float(cue.get("attack_s", 0.0)))
	_purr.volume_db = MIN_DB
	_purr.play()


func stop_purr() -> void:
	Haptics.stop_repeat()
	if _purr == null or not _purr.playing:
		return
	_purr_fader.go(Clock.ticks_s(), 0.0, float(_sub(_sect("cues"), "S03").get("release_s", 0.0)))


## The world clock's phase (world.json); profile = phases[phase].audio_profile. Bed targets and
## the LPF crossfade over profile_crossfade_s; voices, density and birds switch at the midpoint.
func set_phase(phase_id: StringName, immediate: bool = false) -> void:
	if not _pinned:
		_apply_profile(_profile_for(phase_id), immediate)


func set_weather(weather_id: StringName, immediate: bool = false) -> void:
	if not _pinned:
		_apply_weather(weather_id, immediate)


## Sheet open: Music LPF duck (Web: Music bus duck); close releases it (§8.8).
func set_sheet_open(open: bool) -> void:
	_sheet_open = open
	_apply_lpf(float(_sect("duck").get("lpf_tween_s", 0.0)))
	if _web:
		_apply_bus_volumes()


## &"on" | &"ambience" | &"off" (§8.9). Normally driven by the Music setting.
func set_music_mode(mode: StringName) -> void:
	_mode = mode if mode in [MODE_ON, MODE_AMBIENCE, MODE_OFF] else MODE_ON
	var now := Clock.ticks_s()
	var fade := float(_sect("settings").get("mode_fade_s", 0.0))
	_music_mode_fader.go(now, 1.0 if _music_wanted() else 0.0, fade)
	_ambience_mode_fader.go(now, 0.0 if _mode == MODE_OFF else 1.0, fade)
	if not (_started and has_audio and _can_play()):
		return
	if _music_wanted() and not _music_running:
		_start_music(now, 0.0)  # back on: boot fade-ins and a fresh chord
	if _mode != MODE_OFF and _beds.is_empty():
		_start_beds(now, float(_flow.get("boot_bed_fade_in_s", 0.0)))


## group &"music" | &"nature" | &"effects", slider 0..100 (§8.9). Stored through Settings.
func set_volume(group: StringName, slider: int) -> void:
	match group:
		&"music":
			Settings.set_value(Settings.VOLUME_MUSIC, slider)
		&"nature":
			Settings.set_value(Settings.VOLUME_AMBIENCE, slider)
		&"effects":
			Settings.set_value(Settings.VOLUME_EFFECTS, slider)
	_apply_bus_volumes()


## Master StereoEnhance pan_pullout 0 (§8.9). Hidden on Web (no bus effects).
func set_mono(enabled: bool) -> void:
	var r: Array = _bus_roles.get(ROLE_MONO, [])
	if r.size() == 2 and not _web:
		AudioServer.set_bus_effect_enabled(int(r[0]), int(r[1]), enabled)


## Owned wind-chime shells, voice_steps of awake visitors, number of sleepers (§8.7, §5).
func set_world_state(shells_owned: int, awake_visitors: PackedInt32Array, sleeping_visitors: int) -> void:
	var had_shells := _shells_owned > 0
	_shells_owned = shells_owned
	_awake = awake_visitors
	_sleeping = sleeping_visitors
	if not had_shells and _shells_owned > 0 and _started:
		_schedule_gust(Clock.ticks_s())


func current_chord() -> StringName:
	return StringName(String(_current_chord().get("name", "")))


func current_pcs() -> Array:
	return _current_chord().get("pcs", [])


## QA (§8.10): pin a profile and weather regardless of the clock.
func debug_set_clock(phase: StringName, weather: StringName) -> void:
	_pinned = false
	_apply_profile(_profile_for(phase), true)
	_apply_weather(weather, true)
	_pinned = true


## Starts background loads of every asset behind the splash (§8.2) so first use never hitches.
func request_preload() -> void:
	for id: String in _paths:
		var path := String(_paths[id])
		if not _streams.has(path) and not _requested.has(path) and ResourceLoader.exists(path):
			if ResourceLoader.load_threaded_request(path) == OK:
				_requested[path] = true


## Stops every sound now. Quit paths call this a couple of frames before quitting: the
## AudioServer frees stopped playbacks on its next update, so nothing is left at exit.
func stop_all() -> void:
	_started = false
	_music_running = false
	_note_queue.clear()
	Haptics.stop_repeat()
	for c: Node in get_children():
		if c is AudioStreamPlayer:
			(c as AudioStreamPlayer).stop()
	_poly_music = null
	_poly_fx = null
	_pad_playback = null
	_beds.clear()


static func slider_to_db(slider: int) -> float:
	if slider <= 0:
		return MIN_DB
	return VOLUME_CURVE_DB * log(float(slider) / VOLUME_REFERENCE) / log(10.0)


## Builds (or rebuilds) the bus graph from a manifest-style table. Idempotent, so it agrees with
## the generated res://default_bus_layout.tres.
func build_buses(table: Array) -> void:
	_bus_roles.clear()
	for b: Dictionary in table:
		var name := StringName(b["name"])
		var idx := AudioServer.get_bus_index(name)
		if idx < 0:
			idx = AudioServer.bus_count
			AudioServer.add_bus(idx)
			AudioServer.set_bus_name(idx, String(name))
		while AudioServer.get_bus_effect_count(idx) > 0:
			AudioServer.remove_bus_effect(idx, 0)
		var base_db := float(b.get("volume_db", 0.0))
		_bus_base_db[name] = base_db
		AudioServer.set_bus_volume_db(idx, base_db)
		var send := String(b.get("send", ""))
		if send != "":
			AudioServer.set_bus_send(idx, StringName(send))
		for e: Dictionary in _list(b, "effects"):
			var effect := ClassDB.instantiate(StringName(e["class"])) as AudioEffect
			if effect == null:
				push_warning("AudioDirector: unknown effect %s" % e["class"])
				continue
			var props := _sub(e, "props")
			for p: String in props:
				effect.set(p, props[p])
			AudioServer.add_bus_effect(idx, effect)
			var at := AudioServer.get_bus_effect_count(idx) - 1
			AudioServer.set_bus_effect_enabled(idx, at, bool(e.get("enabled", true)))
			if e.has("role"):
				_bus_roles[String(e["role"])] = [idx, at]


# ================================================================= players (§8.3)

func _ensure_players() -> void:
	if _poly_fx != null:
		return
	_poly_fx = _make_poly(BUS_SFX)
	_poly_music = _make_poly(BUS_MUSIC)
	if _purr == null:
		_purr = AudioStreamPlayer.new()
		_purr.bus = BUS_SFX
		add_child(_purr)
	if _web:
		while _pad_web.size() < 2:
			var p := AudioStreamPlayer.new()
			p.bus = BUS_MUSIC
			p.volume_db = MIN_DB
			add_child(p)
			_pad_web.append(p)
	elif _pad == null:
		_pad = AudioStreamPlayer.new()
		_pad.bus = BUS_MUSIC
		_pad.volume_db = MIN_DB
		_pad.stream = _build_pad_stream()
		add_child(_pad)


func _make_poly(bus: StringName) -> AudioStreamPlaybackPolyphonic:
	var p := AudioStreamPlayer.new()
	var s := AudioStreamPolyphonic.new()
	s.polyphony = POLYPHONY
	p.stream = s
	p.bus = bus
	add_child(p)
	p.play()
	return p.get_stream_playback() as AudioStreamPlaybackPolyphonic


## §4.3: clip i = harmony.pad_clip_order[i]; any -> any at the next bar, crossfade 6 beats.
func _build_pad_stream() -> AudioStreamInteractive:
	var pads := AudioStreamInteractive.new()
	pads.clip_count = _clip_order.size()
	for i in _clip_order.size():
		var id := String(_clip_order[i])
		pads.set_clip_name(i, StringName(id))
		pads.set_clip_stream(i, _stream(String(_paths.get(id, ""))))
	pads.add_transition(AudioStreamInteractive.CLIP_ANY, AudioStreamInteractive.CLIP_ANY,
		AudioStreamInteractive.TRANSITION_FROM_TIME_NEXT_BAR, AudioStreamInteractive.TRANSITION_TO_TIME_START,
		AudioStreamInteractive.FADE_CROSS, float(_flow.get("crossfade_beats", 0.0)))
	return pads


# ================================================================= beds and birds (§8.7, §5)

func _start_beds(now: float, fade_s: float) -> void:
	for bed_id: String in _sub(_sub(_sect("profiles"), String(_profile)), "beds"):
		if not _assets.has(bed_id) or _beds.has(bed_id):
			continue
		var players: Array[AudioStreamPlayer] = []
		for i in (2 if _web else 1):
			var p := AudioStreamPlayer.new()
			p.bus = BUS_AMBIENCE
			p.stream = _stream(String(_paths[bed_id]))
			p.volume_db = MIN_DB
			add_child(p)
			players.append(p)
		_beds[bed_id] = {"players": players, "active": 0, "fader": Fader.new(0.0), "silent_since": -INF}
	_retarget_beds(now, fade_s)


## Target gain of each bed = profile level + weather add, with weather.replace and crickets (§8.7).
func _bed_targets(profile: StringName, weather: StringName) -> Dictionary:
	var levels := _sub(_sub(_sect("profiles"), String(profile)), "beds")
	var wx := _sub(_sect("weather"), String(weather))
	var replace := _sub(wx, "replace")
	var add := _sub(wx, "bed_add_db")
	var out := {}
	for bed_id: String in levels:
		out[bed_id] = 0.0
	for bed_id: String in levels:
		var lvl: Variant = levels[bed_id]
		if lvl == null:
			continue
		var target_id := String(replace.get(bed_id, bed_id))
		if target_id == "amb_crickets" and not bool(wx.get("crickets", true)):
			continue
		var asset: Dictionary = _assets.get(target_id, {})
		out[target_id] = db_to_linear(float(lvl) + float(add.get(bed_id, 0.0)) + float(asset.get("base_volume_db", 0.0)))
	return out


func _retarget_beds(now: float, fade_s: float) -> void:
	var targets := _bed_targets(_profile, _weather)
	for bed_id: String in _beds:
		var b: Dictionary = _beds[bed_id]
		var target := float(targets.get(bed_id, 0.0))
		(b["fader"] as Fader).go(now, target, fade_s)
		if target > 0.0:
			_wake_bed(b)


## Restarts a sleeping bed at a seeded random position (§8.3).
func _wake_bed(b: Dictionary) -> void:
	var players: Array = b["players"]
	var p: AudioStreamPlayer = players[int(b["active"])]
	if not p.playing and p.stream != null:
		p.play(_rng.randf() * maxf(0.0, p.stream.get_length() - WEB_BED_XFADE_S))
	b["silent_since"] = -INF


func _sleep_beds(now: float) -> void:
	for bed_id: String in _beds:
		var b: Dictionary = _beds[bed_id]
		var f: Fader = b["fader"]
		if f.value_at(now) > 0.0 or f.moving(now):
			b["silent_since"] = -INF
			continue
		if float(b["silent_since"]) == -INF:
			b["silent_since"] = now
		elif now - float(b["silent_since"]) >= BED_SLEEP_AFTER_S:
			for p: AudioStreamPlayer in b["players"]:
				if p.playing:
					p.stop()


func _schedule_bird(now: float) -> void:
	var birds := _sub(_sub(_sect("profiles"), String(_profile_active)), "birds")
	var mult := float(_sub(_sect("weather"), String(_weather)).get("birds_rate_mult", 1.0))
	if birds.is_empty() or mult <= 0.0:
		_next_bird_s = now + float(_flow.get("weather_crossfade_s", 30.0))  # no birds now: look again later
		return
	_next_bird_s = now + _rand_range(_list(birds, "interval_s")) / mult


func _play_bird() -> void:
	var birds := _sub(_sub(_sect("profiles"), String(_profile_active)), "birds")
	if birds.is_empty() or _bird_ids.is_empty() or not has_audio or not _can_play():
		return
	var choice: Array = _bird_ids.filter(func(b: String) -> bool: return b != _last_bird)
	if choice.is_empty():
		choice = _bird_ids
	_last_bird = String(choice[_rng.randi_range(0, choice.size() - 1)])
	var wx := _sub(_sect("weather"), String(_weather))
	_fx(_stream(String(_paths[_last_bird])), float(birds.get("volume_db", 0.0)) + float(wx.get("birds_add_db", 0.0)),
			BUS_AMBIENCE)


# ================================================================= pads, rests, voices (§8.4, §8.5)

func _start_music(now: float, delay_s: float) -> void:
	_music_running = true
	_chord_i = _rng.randi_range(0, maxi(0, _chords.size() - 1))
	var start := now + delay_s
	_pad_level = Fader.new(_pad_level_target())
	_pad_env = Fader.new(0.0)
	_pad_env.t0 = start
	_pad_env.to = 1.0
	_pad_env.dur = float(_flow.get("boot_pad_fade_in_s", 0.0))
	_next_chord_s = INF
	_voice_next.clear()
	for v: String in _sect("voices"):
		_voice_next[v] = start + float(_sub(_sect("voices"), v).get("period_s", 30.0))
	if delay_s > 0.0:
		get_tree().create_timer(delay_s).timeout.connect(_start_pad_clip)
	else:
		_start_pad_clip()


func _start_pad_clip() -> void:
	if not _music_running:
		return
	var clip := _clip_name(_chord_i)
	if _web:
		_web_switch(clip, 0.0)
	elif _pad != null:
		_pad.play()
		_pad_playback = _pad.get_stream_playback() as AudioStreamPlaybackInteractive
		if _pad_playback != null:
			_pad_playback.switch_to_clip_by_name(StringName(clip))
	chord_changed.emit(current_chord())
	_next_chord_s = Clock.ticks_s() + _hold_bars() * _bar_s


func _clip_name(chord_index: int) -> String:
	if _chords.is_empty():
		return ""
	var pad_set := String(_sub(_sect("profiles"), String(_profile_active)).get("pad_set", "day"))
	return String(_sub(_chords[chord_index], "pad_clips").get(pad_set, ""))


func _hold_bars() -> int:
	var hold := _list(_flow, "chord_hold_bars")
	var lo := int(hold[0]) if hold.size() == 2 else 8
	var hi := int(hold[1]) if hold.size() == 2 else 8
	if _web:
		# §9: no clip may loop on Web, so hold + crossfade must fit inside one pad clip.
		var fade_bars := ceili(float(_flow.get("crossfade_beats", 0.0)) / float(_tempo.get("bar_beats", 4)))
		hi = mini(hi, int(_tempo.get("pad_bars", 8)) - fade_bars)
		lo = mini(lo, hi)
	return _rng.randi_range(lo, hi)


## The sounding chord comes from the engine, not from our request (§8.4).
func _poll_chord() -> void:
	if _pad_playback == null or _chords.is_empty():
		return
	var idx := _pad_playback.get_current_clip_index()
	if idx < 0:
		return
	var chord_i := idx % _chords.size()
	if chord_i != _chord_i:
		_chord_i = chord_i
		chord_changed.emit(current_chord())


func _conduct(now: float) -> void:
	var rest_fade := float(_flow.get("rest_fade_s", 0.0))
	# Profile crossfade midpoint: voices, density and birds switch now; the pad moves to the new set.
	if _profile_active != _profile and now >= _profile_switch_at:
		_profile_active = _profile
		_retarget_pad_level(now, float(_flow.get("profile_crossfade_s", 0.0)) * 0.5)
		if _music_running:
			_request_clip(_chord_i)
	if not _music_running:
		return
	if now >= _next_chord_s and _chords.size() > 1:
		var next := _chord_i
		while next == _chord_i:
			next = _rng.randi_range(0, _chords.size() - 1)
		_request_clip(next)
		_next_chord_s = now + _hold_bars() * _bar_s
	# Fatigue guard: after fatigue_after_s of foreground play, music rests fatigue_rest_s.
	if _foreground_s >= float(_flow.get("fatigue_after_s", INF)) and now >= _fatigue_until_s:
		_fatigue_until_s = now + float(_flow.get("fatigue_rest_s", 0.0))
		_foreground_s = 0.0
		_pad_env.go(now, 0.0, rest_fade)
	elif _fatigue_until_s > -INF and now >= _fatigue_until_s and now >= _rest_until_s:
		_fatigue_until_s = -INF
		_pad_env.go(now, 1.0, rest_fade)
	# Rests: every rest_every_s for rest_len_s, with rest_fade_s fades.
	if now >= _next_rest_s:
		_rest_from_s = now
		_rest_until_s = now + _rand_range(_list(_flow, "rest_len_s"))
		_pad_env.go(now, 0.0, rest_fade)
		_schedule_rest(_rest_until_s)
	if _rest_until_s > -INF and now >= _rest_until_s and now >= _fatigue_until_s:
		_rest_until_s = -INF
		_pad_env.go(now, 1.0, rest_fade)
	# Voices: one repeating timer per voice from boot.
	for v: String in _voice_next:
		if now >= float(_voice_next[v]):
			_voice_next[v] = float(_voice_next[v]) + float(_sub(_sect("voices"), v).get("period_s", 30.0))
			_voice_tick(v, now)


func _request_clip(chord_index: int) -> void:
	var clip := _clip_name(chord_index)
	if _web:
		_chord_i = chord_index
		_web_switch(clip, float(_flow.get("crossfade_beats", 0.0)) * _beat_s)
		chord_changed.emit(current_chord())
	elif _pad_playback != null:
		_pad_playback.switch_to_clip_by_name(StringName(clip))


func _web_switch(clip: String, fade_s: float) -> void:
	if _pad_web.size() < 2 or not _assets.has(clip):
		return
	_pad_web_active = 1 - _pad_web_active
	var p := _pad_web[_pad_web_active]
	p.stream = _stream(String(_paths[clip]))
	p.play()
	_web_pad_fade = {"t0": Clock.ticks_s(), "dur": maxf(0.01, fade_s)}


func _voice_tick(v: String, now: float) -> void:
	var prof := _sub(_sect("profiles"), String(_profile_active))
	var pv := _sub(_sub(prof, "voices"), v)
	if pv.is_empty() or not _music_wanted() or not _can_play():
		return
	if now >= _rest_from_s and now <= _rest_until_s:
		return  # voices skip onsets from the rest fade start
	if now < _hush_until_s or now < _fatigue_until_s:
		return
	var wx := _sub(_sect("weather"), String(_weather))
	var density := maxf(0.0, float(prof.get("density", 0.0)) + float(wx.get("density_add", 0.0)))
	if _rng.randf() > density or now - _last_onset_s < float(_flow.get("min_onset_gap_s", 0.0)):
		return
	_last_onset_s = now
	var voice := _sub(_sect("voices"), v)
	var bank := _bank(String(voice.get("bank", v)))
	var lohi := _list(bank, "range")
	if lohi.size() != 2:
		return
	var lo := int(lohi[0])
	var hi := int(lohi[1])
	var pcs := current_pcs()
	var spread := int(_flow.get("base_spread", 0))
	var m := Harmony.wrap_into(Harmony.snap(int(pv.get("base", 72)) + _rng.randi_range(-spread, spread), pcs), lo, hi)
	var t := now
	var music_add := float(wx.get("music_add_db", 0.0))
	var iois := _list(_flow, "motif_ioi_s")
	var weights := _list(_flow, "motif_ioi_weights")
	var steps := _list(_flow, "motif_steps")
	var vel := _list(_flow, "velocity_db")
	var jitter := float(_flow.get("onset_jitter_s", 0.0))
	for i in int(voice.get("notes", 1)):
		var stream := _note_stream(bank, m)
		if stream != null and vel.size() == 2:
			var db := float(pv.get("db", 0.0)) + _rng.randf_range(float(vel[0]), float(vel[1])) + music_add
			_note_queue.append({"t": t + _rng.randf_range(-jitter, jitter), "stream": stream, "db": db, "bus": BUS_MUSIC})
		if not iois.is_empty():
			t += float(iois[_weighted(weights)])
		if not steps.is_empty():
			m = Harmony.wrap_into(Harmony.pent_step(m, int(steps[_rng.randi_range(0, steps.size() - 1)]), pcs), lo, hi)


func _service_notes(now: float) -> void:
	var i := 0
	while i < _note_queue.size():
		var n: Dictionary = _note_queue[i]
		if float(n["t"]) > now:
			i += 1
			continue
		_note_queue.remove_at(i)
		var stream: AudioStream = n["stream"]
		var bus := StringName(n["bus"])
		if bus == BUS_MUSIC:
			if _poly_music != null:
				_poly_music.play_stream(stream, 0.0, float(n["db"]), 1.0, AudioServer.PLAYBACK_TYPE_DEFAULT, BUS_MUSIC)
		elif n.has("cue"):
			_emit_voice(String(n["cue"]), stream, float(n["db"]), bus, int(n["max"]), 0.0)
		else:
			_fx(stream, float(n["db"]), bus)


func _schedule_rest(from_s: float) -> void:
	var every := _list(_flow, "rest_every_s")
	_next_rest_s = from_s + _rand_range(every) if every.size() == 2 else INF


func _swell(now: float) -> void:
	var up := float(_flow.get("swell_up_s", 0.0))
	var down := float(_flow.get("swell_down_s", 0.0))
	_pad_swell.go(now, db_to_linear(float(_flow.get("swell_db", 0.0))), up)
	get_tree().create_timer(maxf(0.01, up)).timeout.connect(func() -> void: _pad_swell.go(Clock.ticks_s(), 1.0, down))


func _pad_level_target() -> float:
	var prof := _sub(_sect("profiles"), String(_profile_active))
	var wx := _sub(_sect("weather"), String(_weather))
	return db_to_linear(float(prof.get("pad_db", 0.0)) + float(wx.get("music_add_db", 0.0)))


func _retarget_pad_level(now: float, seconds: float) -> void:
	_pad_level.go(now, _pad_level_target(), seconds)


# ================================================================= critters and gusts (§8.7, §5)

func _ambient_events(now: float) -> void:
	if now >= _next_bird_s:
		_play_bird()
		_schedule_bird(now)
	var critters := _sect("critters")
	if now >= _next_coo_s:
		if not _awake.is_empty():
			_play_critter("S13", _awake[_rng.randi_range(0, _awake.size() - 1)], float(critters.get("coo_db", 0.0)))
		_next_coo_s = now + _rand_range(_list(critters, "coo_interval_s"))
	if now >= _next_snore_s:
		if _sleeping > 0 and _profile_active == &"night":
			_play_critter("S14", 0, float(critters.get("snore_db", 0.0)))
		_next_snore_s = now + _rand_range(_list(critters, "snore_interval_s"))
	if now >= _next_gust_s:
		if _shells_owned > 0:
			play_cue(&"S21", {"gust": true, "shells": _shells_owned, "haptic": false})
		_schedule_gust(now)


func _play_critter(cue_id: String, voice_step: int, extra_db: float) -> void:
	if not has_audio or not _can_play():
		return
	var cue := _sub(_sect("cues"), cue_id)
	var layers := _list(cue, "layers")
	if layers.is_empty():
		return
	var layer: Dictionary = layers[0]
	var bank := _bank(String(layer.get("bank", "")))
	var gain := float(layer.get("gain_db", 0.0)) + extra_db
	var bus := StringName(cue.get("bus", "SFX"))
	if String(_sub(layer, "pitch").get("rule", "")) == "variant":
		_fx(_pick_variant(cue_id, bank, false), gain, bus)
	else:
		_fx(_note_stream(bank, _pick_note(cue_id, layer, bank, {"voice_step": voice_step})), gain, bus)


func _schedule_gust(now: float) -> void:
	_next_gust_s = now + _rand_range(_list(_sub(_sect("weather"), String(_weather)), "chime_gust_s"))


# ================================================================= cues and pitch rules (§8.6)

func _play_layer(id: String, cue: Dictionary, layer: Dictionary, bus: StringName, ctx: Dictionary) -> void:
	var bank := _bank(String(layer.get("bank", "")))
	if bank.is_empty():
		return
	var pitch := _sub(layer, "pitch")
	var gain := float(layer.get("gain_db", 0.0))
	if bool(ctx.get("nap", false)) and layer.has("nap_gain_db"):
		gain = float(layer["nap_gain_db"])
	if bool(ctx.get("gust", false)) and layer.has("gust_gain_db"):
		gain = float(layer["gust_gain_db"])
	var max_voices := int(cue.get("max_voices", SFX_BUS_MAX_VOICES))
	match String(pitch.get("rule", "variant")):
		"variant":
			var level := _rng.randf_range(VARIANT_LEVEL_DB[0], VARIANT_LEVEL_DB[1])
			_emit_voice(id, _pick_variant(id, bank, false), gain + level, bus, max_voices, 0.0)
		"chord_clip":
			_emit_voice(id, _pick_variant(id, bank, true), gain, bus, max_voices, 0.0)
		"shell_run":
			_play_shell_run(id, pitch, bank, bus, gain, ctx, max_voices)
		_:
			var note := _pick_note(id, layer, bank, ctx)
			_emit_voice(id, _note_stream(bank, note), gain, bus, max_voices, 0.0)
			var second := _sub(pitch, "second_note")
			if not second.is_empty():
				var interval := int(second.get("interval", 0)) * (-1 if bool(ctx.get("nap", false)) else 1)
				var n2 := Harmony.snap(note + interval, current_pcs())
				_emit_voice(id, _note_stream(bank, n2), gain, bus, max_voices, float(second.get("gap_s", 0.0)))


## MIDI note for the note-based rules of §8.6.
func _pick_note(id: String, layer: Dictionary, bank: Dictionary, ctx: Dictionary) -> int:
	var pitch := _sub(layer, "pitch")
	var pcs := current_pcs()
	var lohi: Array = pitch.get("range", bank.get("range", [0, 127]))
	var lo := int(lohi[0])
	var hi := int(lohi[1])
	var st := _state(id)
	var now := Clock.ticks_s()
	var note := lo
	match String(pitch.get("rule", "")):
		"walk":
			if not st.has("last_note"):
				note = Harmony.wrap_into(Harmony.snap(int(pitch.get("start", lo)), pcs), lo, hi)
			else:
				var last := int(st["last_note"])
				var dir := 1 if _rng.randf() < 0.5 else -1
				note = Harmony.pent_step(last, dir, pcs)
				if note < lo or note > hi:
					note = Harmony.pent_step(last, -dir, pcs)  # reflect at the bank range
		"ladder":
			var reset := float(pitch.get("reset_s", 0.0))
			var step := 0 if now - float(st.get("last_t", -INF)) > reset \
					else mini(int(st.get("step", 0)) + 1, int(pitch.get("cap", 0)))
			st["step"] = step
			note = Harmony.wrap_into(Harmony.pent_step(int(pitch.get("start", lo)), step, pcs), lo, hi)
		"chord_root":
			note = Harmony.place_pc(int(_current_chord().get("root_pc", 0)), lo, hi)
			if bool(pitch.get("uses_voice_step", false)):
				note = Harmony.wrap_into(Harmony.pent_step(note, int(ctx.get("voice_step", 0)), pcs), lo, hi)
		"species":
			note = Harmony.wrap_into(Harmony.pent_step(int(pitch.get("base", lo)), int(ctx.get("voice_step", 0)), pcs), lo, hi)
		"chord_fifth":
			note = Harmony.place_pc(int(_current_chord().get("fifth_pc", 0)), lo, hi)
		"below_last":
			var of := _state(String(pitch.get("of", "")))
			note = Harmony.wrap_into(Harmony.snap(int(of.get("last_note", hi)) - 5, pcs), lo, hi)
		"fixed":
			if pitch.has("midi"):
				note = int(pitch["midi"])
			else:
				note = int(pitch.get("on", lo)) if bool(ctx.get("on", true)) else int(pitch.get("off", lo))
	st["last_note"] = note
	st["last_t"] = now
	return note


## S21: owned shells (first N of harmony.shell_notes) whose pc is in the chord set (all owned if
## none); a tap is a falling run, a gust 1-3 random shells (§8.6).
func _play_shell_run(id: String, pitch: Dictionary, bank: Dictionary, bus: StringName, gain: float,
		ctx: Dictionary, max_voices: int) -> void:
	var shells := _list(_sect("harmony"), "shell_notes")
	var owned := clampi(int(ctx.get("shells", _shells_owned)), 0, shells.size())
	if owned == 0:
		return
	var pcs := current_pcs()
	var pool: Array[int] = []
	for i in owned:
		if pcs.has(posmod(int(shells[i]), Harmony.OCTAVE)):
			pool.append(int(shells[i]))
	if pool.is_empty():
		for i in owned:
			pool.append(int(shells[i]))
	var t := 0.0
	if bool(ctx.get("gust", false)):
		var n_range := _list(pitch, "gust_notes")
		var n := _rng.randi_range(int(n_range[0]), int(n_range[1])) if n_range.size() == 2 else 1
		for _i in n:
			_emit_voice(id, _note_stream(bank, pool[_rng.randi_range(0, pool.size() - 1)]), gain, bus, max_voices, t)
			t += _rand_range(_list(pitch, "gust_gap_s"))
		return
	pool.sort()
	pool.reverse()
	var jitter := float(pitch.get("tap_gap_jitter_s", 0.0))
	for i in pool.size():
		var g := gain + float(pitch.get("tap_step_db", 0.0)) * i
		_emit_voice(id, _note_stream(bank, pool[i]), g, bus, max_voices, t)
		t += float(pitch.get("tap_gap_s", 0.0)) + _rng.randf_range(-jitter, jitter)


## Plays (or schedules) one voice of a cue, at most max_voices per cue (oldest stopped first).
func _emit_voice(id: String, stream: AudioStream, gain_db: float, bus: StringName, max_voices: int,
		delay_s: float) -> void:
	if stream == null:
		return
	if delay_s > 0.0:
		_note_queue.append({"t": Clock.ticks_s() + delay_s, "stream": stream, "db": gain_db, "bus": bus,
			"cue": id, "max": max_voices})
		return
	if _poly_fx == null:
		return
	var st := _state(id)
	var voices: Array = st.get("voices", [])
	voices = voices.filter(func(v: int) -> bool: return _poly_fx.is_stream_playing(v))
	while max_voices > 0 and voices.size() >= max_voices:
		_poly_fx.stop_stream(int(voices.pop_front()))
	var vid := _fx(stream, gain_db, bus)
	if vid >= 0:
		voices.append(vid)
	st["voices"] = voices


## The shared FX polyphonic with a per-voice bus, keeping at most SFX_BUS_MAX_VOICES on SFX (§6).
func _fx(stream: AudioStream, gain_db: float, bus: StringName) -> int:
	if stream == null or _poly_fx == null:
		return -1
	if bus == BUS_SFX:
		_sfx_voices = _sfx_voices.filter(func(v: int) -> bool: return _poly_fx.is_stream_playing(v))
		while _sfx_voices.size() >= SFX_BUS_MAX_VOICES:
			_poly_fx.stop_stream(_sfx_voices.pop_front())
	var vid := _poly_fx.play_stream(stream, 0.0, gain_db, 1.0, AudioServer.PLAYBACK_TYPE_DEFAULT, bus)
	if bus == BUS_SFX:
		_sfx_voices.append(vid)
	return vid


func _pick_variant(id: String, bank: Dictionary, by_chord: bool) -> AudioStream:
	if by_chord:
		var clips := _sub(bank, "web_clips" if _web and bank.has("web_clips") else "clips")
		var path: Variant = clips.get(String(_current_chord().get("clip", "")))
		if path == null and not clips.is_empty():
			path = clips.values()[0]
		return _stream(String(path)) if path != null else null
	var variants := _sub(bank, "web_variants" if _web and bank.has("web_variants") else "variants")
	if variants.is_empty():
		return null
	var keys := variants.keys()
	var st := _state(id)
	var last: Variant = st.get("last_variant")
	var k: Variant = keys[_rng.randi_range(0, keys.size() - 1)]
	while keys.size() > 1 and k == last:
		k = keys[_rng.randi_range(0, keys.size() - 1)]
	st["last_variant"] = k
	return _stream(String(variants[k]))


## The file for a MIDI note. Every F-Lydian note of a bank's range is rendered (§8.5), so the
## exact note is used and pitch_scale stays 1.0 (required on Web, §9).
func _note_stream(bank: Dictionary, midi: int) -> AudioStream:
	var notes := _sub(bank, "web_notes" if _web and bank.has("web_notes") else "notes")
	var path: Variant = notes.get(str(midi))
	return _stream(String(path)) if path != null else null


# ================================================================= profiles, weather, settings

func _apply_profile(profile: StringName, immediate: bool) -> void:
	var now := Clock.ticks_s()
	var fade := 0.0 if immediate else float(_flow.get("profile_crossfade_s", 0.0))
	var changed := profile != _profile
	_profile = profile
	_profile_switch_at = now + fade * 0.5
	if immediate or not _started:
		_profile_active = profile
	if not _started:
		return
	if changed or immediate:
		_retarget_beds(now, fade)
		_apply_lpf(fade)
		if immediate:
			_retarget_pad_level(now, 0.0)
			if _music_running:
				_request_clip(_chord_i)
	if _web:
		_apply_bus_volumes()


func _apply_weather(weather: StringName, immediate: bool) -> void:
	if weather == _weather and not immediate:
		return
	_weather = weather
	if not _started:
		return
	var now := Clock.ticks_s()
	var fade := 0.0 if immediate else float(_flow.get("weather_crossfade_s", 0.0))
	_retarget_beds(now, fade)
	_apply_lpf(fade)
	_retarget_pad_level(now, fade)


## Music LPF = max(music_lpf_min_hz, profile + weather add), ducked to <= 1200 Hz while a sheet is
## open or the app is unfocused (§8.8). The Web build has no bus effects (see _apply_bus_volumes).
func _apply_lpf(tween_s: float) -> void:
	var r: Array = _bus_roles.get(ROLE_DUCK, [])
	if r.size() != 2 or _web:
		return
	var lpf := AudioServer.get_bus_effect(int(r[0]), int(r[1])) as AudioEffectLowPassFilter
	if lpf == null:
		return
	var prof := _sub(_sect("profiles"), String(_profile))
	var wx := _sub(_sect("weather"), String(_weather))
	var target := maxf(float(manifest.get("music_lpf_min_hz", 20.0)),
		float(prof.get("music_lpf_hz", 20000.0)) + float(wx.get("music_lpf_add_hz", 0.0)))
	if _sheet_open or _focus_out:
		target = minf(target, float(_sect("duck").get("sheet_open_lpf_hz", target)))
	if tween_s <= 0.0:
		lpf.cutoff_hz = target
	else:
		create_tween().tween_property(lpf, "cutoff_hz", target, tween_s).set_trans(Tween.TRANS_SINE)


func _apply_bus_volumes() -> void:
	var now := Clock.ticks_s()
	var duck := _sect("duck")
	var web_music_db := 0.0
	if _web:
		if _sheet_open or _focus_out:
			web_music_db += float(duck.get("web_sheet_duck_db", 0.0))
		if _profile == &"night":
			web_music_db += float(duck.get("web_night_music_db", 0.0))
	_set_bus(BUS_MUSIC, Settings.get_int(Settings.VOLUME_MUSIC), _music_mode_fader.value_at(now), web_music_db)
	_set_bus(BUS_AMBIENCE, Settings.get_int(Settings.VOLUME_AMBIENCE), _ambience_mode_fader.value_at(now), 0.0)
	_set_bus(BUS_SFX, Settings.get_int(Settings.VOLUME_EFFECTS), 1.0, 0.0)
	_set_bus(BUS_UI, Settings.get_int(Settings.VOLUME_EFFECTS), 1.0, 0.0)


func _set_bus(bus: StringName, slider: int, mode_gain: float, extra_db: float) -> void:
	var idx := AudioServer.get_bus_index(bus)
	if idx < 0:
		return
	var muted := slider <= 0 or mode_gain <= 0.0
	AudioServer.set_bus_mute(idx, muted)
	if not muted:
		AudioServer.set_bus_volume_db(idx, float(_bus_base_db.get(bus, 0.0)) + slider_to_db(slider)
			+ linear_to_db(mode_gain) + extra_db)


func _update_faders(now: float) -> void:
	if _music_mode_fader.moving(now) or _ambience_mode_fader.moving(now):
		_apply_bus_volumes()
	# Music fully faded out: stop the silenced players (a muted bus still decodes, §8.9).
	if _music_running and not _music_wanted() and not _music_mode_fader.moving(now):
		_apply_bus_volumes()
		_music_running = false
		_note_queue = _note_queue.filter(func(n: Dictionary) -> bool: return StringName(n["bus"]) != BUS_MUSIC)
		if _pad != null:
			_pad.stop()
			_pad_playback = null
		for p: AudioStreamPlayer in _pad_web:
			p.stop()
	if _mode == MODE_OFF and not _ambience_mode_fader.moving(now) and not _beds.is_empty():
		_apply_bus_volumes()
		for bed_id: String in _beds:
			for p: AudioStreamPlayer in _beds[bed_id]["players"]:
				p.stop()
				p.queue_free()
		_beds.clear()
	var pad_g := _pad_level.value_at(now) * _pad_env.value_at(now) * _pad_swell.value_at(now)
	if _pad != null and _pad.playing:
		_pad.volume_db = maxf(MIN_DB, linear_to_db(pad_g))
	if _web and not _pad_web.is_empty():
		_update_web_pads(now, pad_g)
	for bed_id: String in _beds:
		var b: Dictionary = _beds[bed_id]
		var g := (b["fader"] as Fader).value_at(now)
		if _web:
			_update_web_bed(b, g)
		else:
			var players: Array = b["players"]
			(players[0] as AudioStreamPlayer).volume_db = maxf(MIN_DB, linear_to_db(g))
	if _purr != null and _purr.playing:
		var pg := _purr_fader.value_at(now)
		_purr.volume_db = maxf(MIN_DB, linear_to_db(pg))
		if pg <= 0.0 and not _purr_fader.moving(now):
			_purr.stop()


func _update_web_pads(now: float, pad_g: float) -> void:
	var u := 1.0
	if not _web_pad_fade.is_empty():
		u = clampf((now - float(_web_pad_fade["t0"])) / float(_web_pad_fade["dur"]), 0.0, 1.0)
	var cur := _pad_web[_pad_web_active]
	var old := _pad_web[1 - _pad_web_active]
	cur.volume_db = maxf(MIN_DB, linear_to_db(pad_g * sin(u * PI * 0.5)))
	old.volume_db = maxf(MIN_DB, linear_to_db(pad_g * cos(u * PI * 0.5)))
	if u >= 1.0 and old.playing:
		old.stop()


## §9: two players per bed on Web; B starts WEB_BED_XFADE_S before A ends, equal-power crossfade.
func _update_web_bed(b: Dictionary, g: float) -> void:
	var players: Array = b["players"]
	var ai := int(b["active"])
	var a: AudioStreamPlayer = players[ai]
	var other: AudioStreamPlayer = players[1 - ai]
	if a.playing and a.stream != null:
		var left := a.stream.get_length() - a.get_playback_position()
		if left <= WEB_BED_XFADE_S and not other.playing:
			other.play(0.0)
		if other.playing:
			var u := clampf(1.0 - left / WEB_BED_XFADE_S, 0.0, 1.0) * PI * 0.5
			a.volume_db = maxf(MIN_DB, linear_to_db(g * cos(u)))
			other.volume_db = maxf(MIN_DB, linear_to_db(g * sin(u)))
			if left <= 0.05:
				a.stop()
				b["active"] = 1 - ai
			return
	a.volume_db = maxf(MIN_DB, linear_to_db(g))


func _on_setting_changed(key: StringName, value: Variant) -> void:
	match key:
		Settings.MUSIC:
			set_music_mode(StringName(String(value)))
		Settings.VOLUME_MUSIC, Settings.VOLUME_AMBIENCE, Settings.VOLUME_EFFECTS:
			_apply_bus_volumes()
		Settings.MONO:
			set_mono(bool(value))


# ================================================================= helpers

func _music_wanted() -> bool:
	return _mode == MODE_ON


func _can_play() -> bool:
	return DisplayServer.get_name() != "headless"


func _current_chord() -> Dictionary:
	if _chords.is_empty():
		return {}
	var c: Dictionary = _chords[_chord_i]
	return c


func _profile_for(phase: StringName) -> StringName:
	var phases := _sect("phases")
	if phases.has(String(phase)):
		return StringName(String(_sub(phases, String(phase)).get("audio_profile", "day")))
	var content := ContentRegistry.content
	if content.phase_index.has(phase):
		return StringName(String(content.phases[content.phase_index[phase]]["audio_profile"]))
	return &"day"


func _ladder_reset_s(cue: Dictionary) -> float:
	for layer: Dictionary in _list(cue, "layers"):
		var p := _sub(layer, "pitch")
		if p.has("reset_s"):
			return float(p["reset_s"])
	return 0.0


func _bank(name: String) -> Dictionary:
	return _sub(_sect("banks"), name)


func _state(id: String) -> Dictionary:
	if not _cue_state.has(id):
		_cue_state[id] = {}
	return _cue_state[id]


func _rand_range(lohi: Array) -> float:
	if lohi.size() != 2:
		return INF
	return _rng.randf_range(float(lohi[0]), float(lohi[1]))


func _weighted(weights: Array) -> int:
	var tot := 0.0
	for w: Variant in weights:
		tot += float(w)
	var x := _rng.randf() * tot
	var acc := 0.0
	for i in weights.size():
		acc += float(weights[i])
		if x < acc:
			return i
	return maxi(0, weights.size() - 1)


func _sect(key: String) -> Dictionary:
	return _sub(manifest, key)


static func _sub(d: Dictionary, key: String) -> Dictionary:
	var v: Variant = d.get(key)
	return v if v is Dictionary else {}


static func _list(d: Dictionary, key: String) -> Array:
	var v: Variant = d.get(key)
	return v if v is Array else []


func _stream(path: String) -> AudioStream:
	if path == "":
		return null
	if _streams.has(path):
		return _streams[path]
	var s: AudioStream = null
	if _requested.has(path):
		s = ResourceLoader.load_threaded_get(path) as AudioStream
		_requested.erase(path)
	elif ResourceLoader.exists(path):
		s = load(path) as AudioStream
	_streams[path] = s
	return s


## Moves finished background loads into the cache (a few per frame) so no load token is left
## pending (unused requests would otherwise leak at exit).
func _collect_preloads() -> void:
	if _requested.is_empty():
		return
	var done := 0
	for path: String in _requested.keys():
		if ResourceLoader.load_threaded_get_status(path) != ResourceLoader.THREAD_LOAD_IN_PROGRESS:
			_streams[path] = ResourceLoader.load_threaded_get(path) as AudioStream
			_requested.erase(path)
			done += 1
			if done >= PRELOAD_COLLECT_PER_FRAME:
				return
