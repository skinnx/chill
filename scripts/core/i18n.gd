class_name I18n
extends RefCounted
## Locale policy (GDD §7.6, §11): "Same as device" -> device locale vi* gives Vietnamese, anything
## else English. Strings live in i18n/strings.csv (imported by Godot into .translation files and
## registered by [method ensure_translations]); code always goes through tr() and String.format().

const SUPPORTED: Array[String] = ["en", "vi"]
## Generated by Godot's CSV importer from i18n/strings.csv (git-ignored build products). They
## are registered here rather than in project.godot so that the very first import of a fresh
## clone does not log "cannot open" errors before the importer has produced them.
const TRANSLATIONS: Array[String] = ["res://i18n/strings.en.translation", "res://i18n/strings.vi.translation"]
const FALLBACK := "en"
const PREF_DEVICE := "auto"
## Art Bible §9.1 / synthesis §3: Vietnamese lines get +12 % line spacing for stacked marks.
const VI_LINE_SPACING_MUL := 1.12

static var _loaded: bool = false


## Locale for a language preference ("auto", "en", "vi") and an OS locale string ("vi_VN").
static func resolve(pref: String, os_locale: String) -> String:
	if SUPPORTED.has(pref):
		return pref
	return "vi" if os_locale.to_lower().begins_with("vi") else FALLBACK


static func apply(pref: String) -> String:
	ensure_translations()
	var loc := resolve(pref, OS.get_locale())
	TranslationServer.set_locale(loc)
	return loc


## Registers the imported translations once (idempotent).
static func ensure_translations() -> void:
	if _loaded:
		return
	_loaded = true
	for path: String in TRANSLATIONS:
		var tr_res := load(path) as Translation
		if tr_res == null:
			push_error("I18n: missing %s (run the import step)" % path)
			continue
		TranslationServer.add_translation(tr_res)


static func is_vietnamese() -> bool:
	return TranslationServer.get_locale().begins_with("vi")


## tr(key).format(args) with {name}-style placeholders (GDD §8.7).
static func fmt(key: StringName, args: Dictionary = {}) -> String:
	var s := TranslationServer.translate(key)
	return s.format(args) if not args.is_empty() else s


## "about 40 min" style durations for growth timers (GDD §8.6: good news only).
static func duration_text(seconds: float) -> String:
	var minutes := maxi(1, roundi(seconds / 60.0))
	if minutes < 60:
		return fmt(&"TIME_MINUTES", {"minutes": minutes})
	var hours := floori(minutes / 60.0)
	var rest := minutes - hours * 60
	if rest == 0:
		return fmt(&"TIME_HOURS", {"hours": hours})
	return fmt(&"TIME_HOURS_MINUTES", {"hours": hours, "minutes": rest})
