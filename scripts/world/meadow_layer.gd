class_name MeadowLayer
extends Node2D
## L4 meadow ground (Art Bible §2.4, §4.5): the walkable hill from the crest (with its grass
## fringe) down past the bottom of the frame, opaque core + 3 px feather. The path is evaluated in
## the shader from knots (no texture read); the brook line comes from spots.json.

# Data boundary: values read from JSON / Dictionaries are Variants and each one is converted
# explicitly (int(), float(), String() ...) where it is read; the analyzer still flags every
# such conversion, so only that warning is silenced in this file (docs/ARCHITECTURE.md §10).
@warning_ignore_start("unsafe_call_argument")

const CORE_SHADER := "res://shaders/world/meadow_core.gdshader"
const FEATHER_SHADER := "res://shaders/world/meadow.gdshader"
## Felted moss surface and the hollow's relief (generated by art/fx/src/*.py).
const MOSS_TEX := "res://art/fx/moss_tile.png"
const RELIEF_TEX := "res://art/fx/meadow_relief.png"
## Crest sampled every 2 px so the 3-10 px fringe bumps stay round; feather 3 px (§4.5).
const STEP_PX := 2.0
const FEATHER_PX := 3.0
## The ground runs 20 px past the frame bottom (§4.5: "down to y 1940").
const BOTTOM_Y := 1940.0
## Art Bible §2.5 path: crest gap (605, 760) -> behind the stone (560, 1060); stone front
## (540, 1180) -> stream stones (560, 1470); 60 px wide at the crest, 150 px at the brook.
## (design y, centre x, half width, strength); it fades out under bed_1 and returns at the bank.
const PATH_KNOTS: Array[Vector4] = [
	Vector4(746, 607, 22, 0.0), Vector4(775, 606, 30, 1.0), Vector4(860, 620, 37, 1.0),
	Vector4(960, 594, 44, 1.0), Vector4(1066, 558, 54, 0.95), Vector4(1182, 540, 58, 0.9),
	Vector4(1250, 540, 62, 0.5), Vector4(1300, 542, 64, 0.0), Vector4(1392, 550, 70, 0.0),
	Vector4(1440, 556, 75, 0.85),
]
const SLOT_UNIFORMS := {
	&"ground_back_lit": "ground_back_lit", &"ground_front_lit": "ground_front_lit",
	&"path_color": "ground_path", &"grass_tip": "grass_tip", &"grass_root": "grass_root",
}

var crest := PackedVector2Array()

var _feed := PaletteFeed.new()
var _cover_feed := PaletteFeed.new()
var _cover: MultiMeshInstance2D = null
var _materials: Array[ShaderMaterial] = []


func _ready() -> void:
	crest = TerrainMath.sample_meadow(STEP_PX)
	# The hedge and tree line behind the crest (drawn first: the crest overlaps their feet).
	var hedge := BushLayer.new()
	hedge.name = "Hedge"
	add_child(hedge)
	var core := MeshInstance2D.new()
	core.name = "Core"
	core.mesh = SilhouetteMesh.core(crest, BOTTOM_Y)
	core.material = _material(CORE_SHADER)
	add_child(core)
	var edge := MeshInstance2D.new()
	edge.name = "Feather"
	edge.mesh = SilhouetteMesh.feather(crest, FEATHER_PX)
	edge.material = _material(FEATHER_SHADER)
	add_child(edge)
	# Ground cover (clover, moss mounds, wild flowers) lies on the meadow under everything standing.
	_cover = GrassField.build_cover(ContentRegistry.content, _cover_feed)
	add_child(_cover)
	_feed.apply(TimeOfDay.colors)
	TimeOfDay.globals_updated.connect(_on_globals)
	tree_exiting.connect(func() -> void:
		for m: ShaderMaterial in _materials:
			LampRegistry.unbind_material(m)
		LampRegistry.unbind_material(_cover.material as ShaderMaterial))


func _material(path: String) -> ShaderMaterial:
	var mat := ShaderMaterial.new()
	mat.shader = load(path) as Shader
	var knots := PackedVector4Array()
	knots.resize(10)
	for i in PATH_KNOTS.size():
		knots[i] = PATH_KNOTS[i]
	mat.set_shader_parameter(&"u_path", knots)
	mat.set_shader_parameter(&"u_path_count", PATH_KNOTS.size())
	mat.set_shader_parameter(&"moss_tex", load(MOSS_TEX) as Texture2D)
	mat.set_shader_parameter(&"relief_tex", load(RELIEF_TEX) as Texture2D)
	var fit := BrookLayer.centre_fit(ContentRegistry.content)
	mat.set_shader_parameter(&"brook_fit", fit)
	mat.set_shader_parameter(&"brook_half_px", BrookLayer.half_width_px(ContentRegistry.content)
			+ BrookLayer.BANK_PX)
	for u: StringName in SLOT_UNIFORMS:
		_feed.bind(mat, u, SLOT_UNIFORMS[u])
	LampRegistry.bind_material(mat)
	_materials.append(mat)
	return mat


## The path at design y as (y, centre x, half width, strength), interpolated exactly like the
## shader (smoothstep between knots); strength 0 outside the knots. Grass keeps off it.
static func path_at(y: float) -> Vector4:
	if y < PATH_KNOTS[0].x or y > PATH_KNOTS[PATH_KNOTS.size() - 1].x:
		return Vector4(y, 0.0, 0.0, 0.0)
	for i in PATH_KNOTS.size() - 1:
		var a := PATH_KNOTS[i]
		var b := PATH_KNOTS[i + 1]
		if y <= b.x:
			var t := clampf((y - a.x) / maxf(b.x - a.x, 1.0), 0.0, 1.0)
			return a.lerp(b, t * t * (3.0 - 2.0 * t))
	return PATH_KNOTS[PATH_KNOTS.size() - 1]


func _on_globals(_values: Dictionary) -> void:
	_feed.apply(TimeOfDay.colors)
	_cover_feed.apply(TimeOfDay.colors)
