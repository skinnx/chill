class_name ForegroundFrame
extends Node2D
## L5 foreground frame (Art Bible §2.3, §4.16): dark, out-of-focus corner pieces under the
## Foreground Parallax2D (scroll 1.3): reeds bottom-left, clover bottom-right, a leafy bough hanging
## from the top-right corner. The bough is anchored to the VISIBLE top, so tall phones keep it in
## the corner. Pieces come from art/props/fg_atlas.svg (+ .json), generated by props_svg.py.

# Data boundary: values read from JSON / Dictionaries are Variants and each one is converted
# explicitly (int(), float(), String() ...) where it is read; the analyzer still flags every
# such conversion, so only that warning is silenced in this file (docs/ARCHITECTURE.md §10).
@warning_ignore_start("unsafe_call_argument")

const ATLAS_JSON := "res://art/props/fg_atlas.json"
const SHADER_PATH := "res://shaders/world/fg_frame.gdshader"
const ANCHOR_TOP := "top"

var _top_pieces: Array[Sprite2D] = []
var _top_y := PackedFloat64Array()


func _ready() -> void:
	var doc: Dictionary = JSON.parse_string(FileAccess.get_file_as_string(ATLAS_JSON))
	var atlas := load(String(doc["atlas"])) as Texture2D
	var mat := ShaderMaterial.new()
	mat.shader = load(SHADER_PATH) as Shader
	var mats: Dictionary = ContentRegistry.palettes()["materials"]
	var size := atlas.get_size()
	for part: Dictionary in doc["parts"]:
		var r := PackedFloat64Array(part["region"] as Array)
		var o := PackedFloat64Array(part["origin"] as Array)
		var sp := Sprite2D.new()
		sp.name = String(part["id"])
		sp.texture = atlas
		sp.region_enabled = true
		sp.region_rect = Rect2(r[0], r[1], r[2], r[3])
		sp.centered = false
		sp.position = Vector2(o[0], o[1])
		sp.material = mat
		add_child(sp)
		var m: Dictionary = mats[String(part["material"])]
		sp.set_instance_shader_parameter(&"i_lit", Color.html(String(m["lit"])))
		sp.set_instance_shader_parameter(&"i_shade", Color.html(String(m["shade"])))
		sp.set_instance_shader_parameter(&"i_detail", Color.html(String(m["detail"])))
		sp.set_instance_shader_parameter(&"i_region", Vector4(r[0] / size.x, r[1] / size.y, r[2] / size.x, r[3] / size.y))
		var sw := PackedFloat64Array(part["sway"] as Array)
		sp.set_instance_shader_parameter(&"i_sway", Vector4(sw[0], sw[1], sw[2], TerrainMath.hash01(sp.name.hash(), 9) * TAU))
		if String(part["anchor"]) == ANCHOR_TOP:
			_top_pieces.append(sp)
			_top_y.append(o[1])
	get_viewport().size_changed.connect(_layout)
	_layout.call_deferred()
	# Governor tier 1+ drops L5 (Art Bible §4.19 mitigation).
	FrameGovernor.tier_changed.connect(func(t: int) -> void: visible = t == 0)
	visible = FrameGovernor.tier == 0


## Top-anchored pieces follow the visible top (design y = -world_offset.y on tall screens).
func _layout() -> void:
	for i in _top_pieces.size():
		_top_pieces[i].position.y = _top_y[i] - TimeOfDay.world_offset.y
