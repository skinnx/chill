class_name PropsLayer
extends Node2D
## Props and art dressing of the hollow (Art Bible §2.4, §4.9, §6.4-6.5): every piece is a region of
## ONE tone-mask atlas (art/props/props_atlas.svg + .json, generated by art/props/src/props_svg.py)
## drawn with ONE shared prop_tone material, so pieces batch wherever y-sort lets them. Each piece
## sits under a sort node at its y-sort origin (where creatures and beds sort against it), with a
## tinted contact shadow at its foot. Also builds the willow's frond curtain (one mesh) and owns
## touch feedback for the touchable props (spots.json tap_action): squash 0.94 + S01 on touch-down,
## then [signal prop_tapped] for the owner of the action (UI: open_basket, open_postcards;
## décor: ring_chime).
##
## QA user arg: --debug-lamps registers lantern-sized lamps at the first 5 firefly_lantern anchors
## (spots.json) so the night light pools and brook reflections can be judged before décor is placed.

# Data boundary: values read from JSON / Dictionaries are Variants and each one is converted
# explicitly (int(), float(), String() ...) where it is read; the analyzer still flags every
# such conversion, so only that warning is silenced in this file (docs/ARCHITECTURE.md §10).
@warning_ignore_start("unsafe_call_argument")

## Touch-down on a touchable prop (design px of the touch). Connect from the UI / décor layer.
signal prop_tapped(prop_id: StringName, action: StringName, design_pos: Vector2)

const ATLAS_JSON := "res://art/props/props_atlas.json"
const SHADER_PATH := "res://shaders/props/prop_tone.gdshader"
const FROND_SHADER := "res://shaders/props/willow_frond.gdshader"
## Shadow height (px) used for the cast length is the part's own height.
const MIN_RIM_PX := 40
## motion_tokens ui.world_touch_squash 0.94; tint decays over ~micro.
const TAP_TINT_DECAY_S := 0.25
const CUE_TOUCH := &"S01"
const ARG_DEBUG_LAMPS := "--debug-lamps"
const DEBUG_LAMP_COUNT := 5
## Art Bible §8.3: lantern pools r 150 px; the lamp sits at the lantern head (~120 px above the foot).
const LANTERN_POOL_R := 150.0
## The jar's glowing core relative to the lantern foot (props_svg.py lantern_jar), and its halo
## (Art Bible §6.6: halo_add r0 18 px).
const LANTERN_JAR_OFFSET := Vector2(36.0, -92.0)
const LANTERN_HALO_R0 := 18.0
const LANTERN_HALO_QUAD := 108.0
const LANTERN_HALO_ALPHA := 0.6
## Art Bible §8.3: the glow mushrooms are the night focal; their warm pool (design px, radius, intensity).
const MUSHROOM_LAMP := &"glow_mushrooms"
const MUSHROOM_LAMP_POS := Vector2(490, 1166)
const MUSHROOM_LAMP_R := 72.0
const MUSHROOM_LAMP_I := 1.0
## Willow fronds (Art Bible §6.4): two rows hanging from the crown's lower edge, a darker back row
## and a lighter front row (QA round 1: layered frond strips at two values instead of a curtain
## fill); (root x, root y, length px, tip bend px), back row first. The trunk stays visible.
const FRONDS: Array[Vector4] = [
	Vector4(-118, 640, 190, -10), Vector4(-66, 628, 230, -6), Vector4(-14, 640, 210, -4),
	Vector4(44, 652, 170, -2), Vector4(206, 650, 180, 4), Vector4(256, 636, 220, 8),
	Vector4(306, 640, 200, 12), Vector4(354, 650, 160, 16),
]
const FRONDS_FRONT: Array[Vector4] = [
	Vector4(-92, 660, 150, -8), Vector4(-40, 668, 186, -6), Vector4(12, 676, 140, -3),
	Vector4(66, 690, 96, 0), Vector4(186, 690, 104, 3), Vector4(232, 676, 160, 6),
	Vector4(282, 664, 176, 10), Vector4(332, 668, 140, 14), Vector4(378, 676, 108, 18),
]
## Row values (frond shader COLOR.a): back row darker.
const FROND_ROW_VALUE := Vector2(0.74, 1.0)
## Glow-mushroom cap halos (Art Bible §6.5, §8.3): design px of each cap, r0 10 px, accent, night.
const MUSHROOM_HALOS: Array[Vector2] = [Vector2(468, 1156), Vector2(489, 1146), Vector2(509, 1161)]
const MUSHROOM_HALO_R0 := 10.0
const MUSHROOM_HALO_QUAD := 64.0
const MUSHROOM_HALO_ALPHA := 0.55
const MUSHROOM_HALO_SORT_Y := 1183.0
const FROND_SEGMENTS := 14
const FROND_STRIP_PX := 24.0
const FROND_MAX_LEN := 260.0
const FROND_AMP_PX := Vector2(10.0, 18.0)
const FROND_SORT_Y := 805.0
## The willow crown as felted canopy masses (bush.gdshader, object mode, willow_leaf): (root x, root
## y, radius, height k) in design px, back to front; sorts at the crown's y (after the trunk).
const CROWN_SORT_Y := 801.0
const CROWN_MASSES: Array[Vector4] = [
	Vector4(-36, 600, 96, 1.0), Vector4(300, 600, 88, 1.0), Vector4(96, 520, 104, 1.1),
	Vector4(226, 512, 96, 1.05), Vector4(14, 640, 92, 0.95), Vector4(160, 618, 120, 1.0),
	Vector4(262, 650, 82, 0.9),
]
## The shadowed inside of the canopy behind the fronds (darker willow shade).
const CROWN_INNER := Vector4(130, 760, 118, 0.9)
const CROWN_INNER_SORT_Y := 799.0
const CROWN_INNER_DARK := 0.62
const CROWN_SWAY_K := 47.0
## Felted shrubs hugging the hollow's left / right edges (round-2 directive 3): (root x, y, radius,
## height k); partly off-frame so they frame the scene without covering a spot.
const EDGE_SHRUBS: Array[Vector4] = [
	Vector4(-46, 992, 72, 1.0), Vector4(-36, 1334, 82, 1.05), Vector4(-24, 1704, 96, 1.0),
	Vector4(1118, 1002, 76, 1.1), Vector4(1112, 1256, 70, 0.95), Vector4(1126, 1690, 96, 1.05),
]
const SHRUB_SWAY_K := Vector2(40.0, 56.0)

var _atlas: Texture2D
var _mat: ShaderMaterial
var _debug_parts: Array[Dictionary] = []
var _shadows: Array[ContactShadow] = []
## prop id -> {hit: float radius px, centre: Vector2, action: StringName, sprites: Array[Sprite2D]}
var _touchables: Dictionary = {}
var _squash: Dictionary = {}
var _tint: Dictionary = {}


func _ready() -> void:
	var doc: Dictionary = JSON.parse_string(FileAccess.get_file_as_string(ATLAS_JSON))
	_atlas = load(String(doc["atlas"])) as Texture2D
	_mat = ShaderMaterial.new()
	_mat.shader = load(SHADER_PATH) as Shader
	var content := ContentRegistry.content
	var mats: Dictionary = ContentRegistry.palettes()["materials"]
	var lk: Dictionary = ContentRegistry.motion_tokens()["loops_k"]
	for part: Dictionary in doc["parts"]:
		if int(part.get("debug", 0)) != 0:
			_debug_parts.append(part)
			continue
		_add_part(part, content, mats)
	_build_crown(mats)
	_build_fronds(mats, lk)
	_build_shrubs()
	_build_halos(lk)
	_index_touchables(content)
	LampRegistry.set_lamp(MUSHROOM_LAMP, MUSHROOM_LAMP_POS, MUSHROOM_LAMP_R, MUSHROOM_LAMP_I)
	if OS.get_cmdline_user_args().has(ARG_DEBUG_LAMPS):
		_debug_lamps(content)
	_update_light(current_light())
	TimeOfDay.globals_updated.connect(_update_light)
	tree_exiting.connect(func() -> void: LampRegistry.remove_lamp(MUSHROOM_LAMP))
	set_process(false)


func _add_part(part: Dictionary, content: GameContent, mats: Dictionary, offset: Vector2 = Vector2.ZERO) -> void:
	var c := PackedFloat64Array(part["centre"] as Array)
	var centre := Vector2(c[0], c[1]) + offset
	var sort_y := float(part["sort_y"]) + offset.y
	var prop := StringName(String(part["prop"]))
	if prop != &"":
		var origin := prop_centre(content, prop)
		centre += origin
		sort_y += origin.y
	var node := Node2D.new()
	node.name = String(part["id"])
	node.position = Vector2(centre.x, sort_y)
	add_child(node)
	var r := PackedFloat64Array(part["region"] as Array)
	var region := Rect2(r[0], r[1], r[2], r[3])
	if part.has("shadow"):
		var s := PackedFloat64Array(part["shadow"] as Array)
		var foot_y := s[3] + (prop_centre(content, prop).y if prop != &"" else 0.0)
		var sh := ContactShadow.new(Vector2(s[0], s[1]), region.size.y, s[2])
		sh.position = Vector2(0.0, foot_y - sort_y)
		node.add_child(sh)
		_shadows.append(sh)
	var sp := Sprite2D.new()
	sp.texture = _atlas
	sp.region_enabled = true
	sp.region_rect = region
	sp.centered = true
	sp.position = centre - node.position
	sp.material = _mat
	node.add_child(sp)
	var m: Dictionary = mats[String(part["material"])]
	var em := float(part.get("emission", 0.0))
	sp.set_instance_shader_parameter(&"i_lit", Color.html(String(m["lit"])))
	sp.set_instance_shader_parameter(&"i_shade", Color.html(String(m["shade"])))
	var detail := Color.html(String(m["detail"]))
	detail.a = em
	sp.set_instance_shader_parameter(&"i_detail", detail)
	var size := _atlas.get_size()
	sp.set_instance_shader_parameter(&"i_region", Vector4(region.position.x / size.x, region.position.y / size.y,
			region.size.x / size.x, region.size.y / size.y))
	var rim_on := float(part.get("rim", 1)) > 0.0 and minf(region.size.x, region.size.y) >= MIN_RIM_PX
	sp.set_instance_shader_parameter(&"i_fx", Vector4(0.0, 1.0, 1.0 if rim_on else 0.0, float(part.get("ground", 0.0))))
	if part.has("sway"):
		var sw := PackedFloat64Array(part["sway"] as Array)
		sp.set_instance_shader_parameter(&"i_sway", Vector4(sw[0], sw[1], sw[2], TerrainMath.hash01(
				String(part["id"]).hash(), 5) * TAU))
	if prop != &"":
		var t: Dictionary = _touchables.get(prop, {})
		var list: Array = t.get("sprites", [])
		list.append(sp)
		_touchables[prop] = {"sprites": list}


## The light globals as TimeOfDay would push them now (its signal carries the same dictionary).
static func current_light() -> Dictionary:
	var v := TimeOfDay.evaluate(Clock.now_local())
	v[&"g_world_offset"] = TimeOfDay.world_offset
	return v


func _debug_lamps(content: GameContent) -> void:
	var anchors: Dictionary = content.anchors_by_decor.get(&"firefly_lantern", {})
	var pos: Array = anchors.get("positions", [])
	var mats: Dictionary = ContentRegistry.palettes()["materials"]
	var lk: Dictionary = ContentRegistry.motion_tokens()["loops_k"]
	var bk: Array = lk["lantern_breath"]
	for i in mini(DEBUG_LAMP_COUNT, pos.size()):
		var q := PackedFloat64Array(pos[i] as Array)
		var foot := GardenRules.frame_to_px(content, Vector2(q[0], q[1]))
		# A lantern stamp at each lamp so every pool has a visible source (QA round 1).
		for part: Dictionary in _debug_parts:
			_add_part(part, content, mats, foot)
		var head := foot + LANTERN_JAR_OFFSET
		var node := Node2D.new()
		node.name = "debug_lantern_halo_%d" % i
		node.position = Vector2(head.x, foot.y + 2.0)
		add_child(node)
		var h := HaloSprite.new().setup(LANTERN_HALO_R0, LANTERN_HALO_QUAD, Color(1, 1, 1, LANTERN_HALO_ALPHA),
				float(bk[0]), HaloSprite.FLAG_NIGHT + HaloSprite.FLAG_ACCENT, float(i) * 1.7)
		h.position = head - node.position
		node.add_child(h)
		LampRegistry.set_lamp(StringName("debug_lantern_%d" % i), Vector2(head.x, foot.y - 4.0), LANTERN_POOL_R, 1.0)


## spots.json prop centre in design px.
static func prop_centre(content: GameContent, prop_id: StringName) -> Vector2:
	var p: Dictionary = content.props_by_id.get(prop_id, {})
	if p.is_empty():
		return Vector2.ZERO
	return GardenRules.frame_to_px(content, Vector2(float(p["x"]), float(p["y"])))


func _index_touchables(content: GameContent) -> void:
	var frame: Dictionary = content.spots_doc["frame"]
	var dp := float(frame["px_per_dp"])
	for id: StringName in _touchables.keys():
		var p: Dictionary = content.props_by_id.get(id, {})
		var action := StringName(String(p.get("tap_action", "")))
		var hit := float(p.get("hit_dp", 0.0)) * dp * 0.5
		if action == &"" or hit <= 0.0:
			_touchables.erase(id)
			continue
		var t: Dictionary = _touchables[id]
		t["action"] = action
		t["hit"] = hit
		t["centre"] = prop_centre(content, id)


func _build_halos(lk: Dictionary) -> void:
	var node := Node2D.new()
	node.name = "mushroom_halos"
	node.position = Vector2(MUSHROOM_LAMP_POS.x, MUSHROOM_HALO_SORT_Y)
	add_child(node)
	var gk: Array = lk["glow_mushroom"]
	for i in MUSHROOM_HALOS.size():
		var h := HaloSprite.new().setup(MUSHROOM_HALO_R0, MUSHROOM_HALO_QUAD, Color(1, 1, 1, MUSHROOM_HALO_ALPHA),
				float(gk[0]), HaloSprite.FLAG_NIGHT + HaloSprite.FLAG_ACCENT, float(i) * 2.1)
		h.position = MUSHROOM_HALOS[i] - node.position
		node.add_child(h)


func _build_crown(mats: Dictionary) -> void:
	var leaf := Color.html(String((mats["willow_leaf"] as Dictionary)["lit"]))
	var shade := Color.html(String((mats["willow_leaf"] as Dictionary)["shade"]))
	var inner_node := Node2D.new()
	inner_node.name = "willow_crown_inner"
	inner_node.position = Vector2(0.0, CROWN_INNER_SORT_Y)
	add_child(inner_node)
	var dark := shade * CROWN_INNER_DARK
	dark.a = 1.0
	var inner := BushSprite.new().setup(CROWN_INNER.z, 0.37, 1.0, CROWN_INNER.w, false, CROWN_SWAY_K, 0.0, dark)
	inner.position = Vector2(CROWN_INNER.x, CROWN_INNER.y - CROWN_INNER_SORT_Y)
	inner_node.add_child(inner)
	var node := Node2D.new()
	node.name = "willow_crown"
	node.position = Vector2(0.0, CROWN_SORT_Y)
	add_child(node)
	for i in CROWN_MASSES.size():
		var m: Vector4 = CROWN_MASSES[i]
		var b := BushSprite.new().setup(m.z, TerrainMath.hash01(i, 81), 1.0, m.w, false, CROWN_SWAY_K,
				TerrainMath.hash01(i, 82) * TAU, Color(leaf.r, leaf.g, leaf.b, 1.0))
		b.position = Vector2(m.x, m.y - CROWN_SORT_Y)
		node.add_child(b)


func _build_shrubs() -> void:
	for i in EDGE_SHRUBS.size():
		var e: Vector4 = EDGE_SHRUBS[i]
		var b := BushSprite.new().setup(e.z, TerrainMath.hash01(i, 91), 1.0, e.w, false,
				floorf(lerpf(SHRUB_SWAY_K.x, SHRUB_SWAY_K.y, TerrainMath.hash01(i, 92))), TerrainMath.hash01(i, 93) * TAU)
		b.name = "edge_shrub_%d" % i
		b.position = Vector2(e.x, e.y)
		add_child(b)


func _build_fronds(mats: Dictionary, lk: Dictionary) -> void:
	var m: Dictionary = mats["willow_leaf"]
	var mat := ShaderMaterial.new()
	mat.shader = load(FROND_SHADER) as Shader
	mat.set_shader_parameter(&"leaf_lit", Color.html(String(m["lit"])))
	mat.set_shader_parameter(&"leaf_shade", Color.html(String(m["shade"])))
	mat.set_shader_parameter(&"leaf_detail", Color.html(String(m["detail"])))
	mat.set_shader_parameter(&"strip_px", FROND_STRIP_PX)
	mat.set_shader_parameter(&"max_len_px", FROND_MAX_LEN)
	mat.set_shader_parameter(&"max_amp_px", FROND_AMP_PX.y)
	var fk: Array = lk["flower_sway"]
	mat.set_shader_parameter(&"sway_k", float(fk[0]) * 0.65)
	LampRegistry.bind_material(mat)
	var verts := PackedVector2Array()
	var uvs := PackedVector2Array()
	var cols := PackedColorArray()
	var idx := PackedInt32Array()
	var all_fronds: Array[Vector4] = []
	all_fronds.append_array(FRONDS)
	all_fronds.append_array(FRONDS_FRONT)
	for fi in all_fronds.size():
		var fr: Vector4 = all_fronds[fi]
		var amp := lerpf(FROND_AMP_PX.x, FROND_AMP_PX.y, TerrainMath.hash01(fi, 61)) / FROND_AMP_PX.y
		var row := FROND_ROW_VALUE.x if fi < FRONDS.size() else FROND_ROW_VALUE.y
		var col := Color(TerrainMath.hash01(fi, 62), amp, fr.z / FROND_MAX_LEN, row)
		var base := verts.size()
		for s in FROND_SEGMENTS + 1:
			var t := float(s) / FROND_SEGMENTS
			var x := fr.x + fr.w * t * t
			var y := fr.y + fr.z * t
			verts.append(Vector2(x - FROND_STRIP_PX * 0.5, y - FROND_SORT_Y))
			uvs.append(Vector2(0.0, t))
			cols.append(col)
			verts.append(Vector2(x + FROND_STRIP_PX * 0.5, y - FROND_SORT_Y))
			uvs.append(Vector2(1.0, t))
			cols.append(col)
		for s in FROND_SEGMENTS:
			var k := base + s * 2
			idx.append_array(PackedInt32Array([k, k + 2, k + 1, k + 1, k + 2, k + 3]))
	var arrays := []
	arrays.resize(Mesh.ARRAY_MAX)
	arrays[Mesh.ARRAY_VERTEX] = verts
	arrays[Mesh.ARRAY_TEX_UV] = uvs
	arrays[Mesh.ARRAY_COLOR] = cols
	arrays[Mesh.ARRAY_INDEX] = idx
	var mesh := ArrayMesh.new()
	mesh.add_surface_from_arrays(Mesh.PRIMITIVE_TRIANGLES, arrays)
	var node := Node2D.new()
	node.name = "willow_fronds"
	node.position = Vector2(0.0, FROND_SORT_Y)
	add_child(node)
	var mi := MeshInstance2D.new()
	mi.mesh = mesh
	mi.material = mat
	node.add_child(mi)


func _update_light(values: Dictionary) -> void:
	if values.is_empty():
		return
	for s: ContactShadow in _shadows:
		s.set_light(values)


func _unhandled_input(event: InputEvent) -> void:
	var pressed := false
	if event is InputEventScreenTouch:
		pressed = (event as InputEventScreenTouch).pressed
	elif event is InputEventMouseButton:
		var mb := event as InputEventMouseButton
		pressed = mb.pressed and mb.button_index == MOUSE_BUTTON_LEFT and mb.device != InputEvent.DEVICE_ID_EMULATION
	if not pressed or _touchables.is_empty():
		return
	var local := make_input_local(event)
	var pos: Vector2 = local.get("position")
	var best: StringName = &""
	var best_d := INF
	for id: StringName in _touchables:
		var t: Dictionary = _touchables[id]
		var d := pos.distance_to(t["centre"] as Vector2)
		if d <= float(t["hit"]) and d < best_d:
			best = id
			best_d = d
	if best == &"":
		return
	_press(best)
	AudioDirector.play_cue(CUE_TOUCH, {"world": true, "position": get_global_transform_with_canvas() * pos})
	prop_tapped.emit(best, StringName(_touchables[best]["action"]), pos)
	get_viewport().set_input_as_handled()


func _press(id: StringName) -> void:
	var press := Motion.spring(&"press", 1.0)
	press.target = float(ContentRegistry.motion_tokens()["ui"]["world_touch_squash"])
	_squash[id] = [press, Motion.duration(&"micro")]
	_tint[id] = 1.0
	set_process(true)
	FrameGovernor.hold_for(Motion.duration(&"release") + Motion.duration(&"micro"))


func _process(delta: float) -> void:
	var busy := false
	for id: StringName in _squash.keys():
		var entry: Array = _squash[id]
		var s: Spring = entry[0]
		var hold := float(entry[1]) - delta
		entry[1] = hold
		if hold <= 0.0 and s.target < 1.0:
			var pop := Motion.spring(&"pop", s.value)
			pop.velocity = s.velocity
			pop.target = 1.0
			entry[0] = pop
			s = pop
		var v := s.step(delta)
		var tint := maxf(0.0, float(_tint.get(id, 0.0)) - delta / TAP_TINT_DECAY_S)
		_tint[id] = tint
		var t: Dictionary = _touchables[id]
		var sprites: Array = t["sprites"]
		for sp: Sprite2D in sprites:
			var fx: Vector4 = sp.get_instance_shader_parameter(&"i_fx")
			sp.set_instance_shader_parameter(&"i_fx", Vector4(tint, v, fx.z, fx.w))
		if s.is_at_rest() and s.target >= 1.0 and tint <= 0.0:
			_squash.erase(id)
		else:
			busy = true
	set_process(busy)
