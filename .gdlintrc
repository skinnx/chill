# gdlint (gdtoolkit==4.5.0, synthesis D5) tuned to docs/ARCHITECTURE.md §10 and the official
# GDScript style guide. Run from the repo root: `gdlint .` (CI: .github/workflows/ci.yml, lint job).
# Vendored addons are third-party code and are not linted.
#
# Deviations from the gdtoolkit defaults, and why:
#   max-line-length 100 -> 120   the code base wraps at ~120 (tabs count as 1 here)
#   max-file-lines 1000 -> 1500  audio_director.gd executes the whole AUDIO_BIBLE §8 contract
#   max-public-methods 20 -> 50  WorldSim's player-action + query API is one cohesive surface
#   max-returns 6 -> 10          validators return early on each malformed field (save decode)
#   function-variable-name       also allows a trailing underscore (l_, m_, s_ in the OKLab code,
#                                matching the reference implementation's names)

class-definitions-order:
- tools
- classnames
- extends
- docstrings
- signals
- enums
- consts
- staticvars
- exports
- pubvars
- prvvars
- onreadypubvars
- onreadyprvvars
- others
class-load-variable-name: (([A-Z][a-z0-9]*)+|_?[a-z][a-z0-9]*(_[a-z0-9]+)*)
class-name: ([A-Z][a-z0-9]*)+
class-variable-name: _?[a-z][a-z0-9]*(_[a-z0-9]+)*
comparison-with-itself: null
constant-name: _?[A-Z][A-Z0-9]*(_[A-Z0-9]+)*
disable: []
duplicated-load: null
enum-element-name: '[A-Z][A-Z0-9]*(_[A-Z0-9]+)*'
enum-name: ([A-Z][a-z0-9]*)+
excluded_directories: !!set
  .git: null
  .godot: null
  addons: null
  build: null
expression-not-assigned: null
function-argument-name: _?[a-z][a-z0-9]*(_[a-z0-9]+)*
function-arguments-number: 10
function-name: (_on_([A-Z][a-z0-9]*)+(_[a-z0-9]+)*|_?[a-z][a-z0-9]*(_[a-z0-9]+)*)
function-preload-variable-name: ([A-Z][a-z0-9]*)+
function-variable-name: '[a-z][a-z0-9]*(_[a-z0-9]+)*_?'
load-constant-name: (([A-Z][a-z0-9]*)+|_?[A-Z][A-Z0-9]*(_[A-Z0-9]+)*)
loop-variable-name: _?[a-z][a-z0-9]*(_[a-z0-9]+)*
max-file-lines: 1500
max-line-length: 120
max-public-methods: 50
max-returns: 10
mixed-tabs-and-spaces: null
no-elif-return: null
no-else-return: null
signal-name: '[a-z][a-z0-9]*(_[a-z0-9]+)*'
sub-class-name: _?([A-Z][a-z0-9]*)+
tab-characters: 1
trailing-whitespace: null
unnecessary-pass: null
unused-argument: null
